generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Analysis {
  id                 String   @id @default(cuid())
  resumeName         String
  jobDescription     String
  matchScore         Int
  scoreRationale     String
  matchingSkills     String
  skillGaps          String
  interviewQuestions String
  createdAt          DateTime @default(now())

  @@index([matchScore])
  @@index([createdAt])
}